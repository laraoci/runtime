{
    "name": "laraoci/smoke-fixture",
    "type": "project",
    "description": "Minimal Laravel application exercised by the LaraOCI smoke suite (LOCI-027). Not published, not a template.",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
