# shellcheck shell=bash disable=SC2034  # sourced data file; vars used by callers
# Single source of truth for every pinned CI/dev tool in LaraOCI.
#
# Each tool is pinned by SHA-256, not just version: a release asset can be
# replaced in place, so the hash is the trust anchor (see bin/fetch-tools.sh).
# Both CI (.github/workflows) and local `make tools` read THIS file, so a
# version exists in exactly one place and local/CI cannot drift.
#
# Format per tool: NAME_VERSION / NAME_URL / NAME_SHA256 / NAME_KIND
#   KIND=binary  -> the asset IS the executable (installed directly)
#   KIND=tar:PATH -> asset is a .tar.gz; PATH is the executable inside it
#
# To bump a tool: change its version + URL, download the new asset, put its
# sha256 here, and run `make tools`. tests/unit/tools.bats asserts every SHA is
# 64 hex chars and every URL contains its declared version.

# --- shfmt (shell formatter) ------------------------------------------------
SHFMT_VERSION="3.13.1"
SHFMT_URL="https://github.com/mvdan/sh/releases/download/v3.13.1/shfmt_v3.13.1_linux_amd64"
SHFMT_SHA256="fb096c5d1ac6beabbdbaa2874d025badb03ee07929f0c9ff67563ce8c75398b1"
SHFMT_KIND="binary"

# --- yq (YAML processor, mikefarah) -----------------------------------------
YQ_VERSION="4.53.3"
YQ_URL="https://github.com/mikefarah/yq/releases/download/v4.53.3/yq_linux_amd64"
YQ_SHA256="fa52a4e758c63d38299163fbdd1edfb4c4963247918bf9c1c5d31d84789eded4"
YQ_KIND="binary"

# --- hadolint (Dockerfile linter) -------------------------------------------
HADOLINT_VERSION="2.14.0"
HADOLINT_URL="https://github.com/hadolint/hadolint/releases/download/v2.14.0/hadolint-linux-x86_64"
HADOLINT_SHA256="6bf226944684f56c84dd014e8b979d27425c0148f61b3bd99bcc6f39e9dc5a47"
HADOLINT_KIND="binary"

# --- actionlint (GitHub Actions linter) -------------------------------------
ACTIONLINT_VERSION="1.7.7"
ACTIONLINT_URL="https://github.com/rhysd/actionlint/releases/download/v1.7.7/actionlint_1.7.7_linux_amd64.tar.gz"
ACTIONLINT_SHA256="023070a287cd8cccd71515fedc843f1985bf96c436b7effaecce67290e7e0757"
ACTIONLINT_KIND="tar:actionlint"

# --- bats (test runner) -----------------------------------------------------
# bats is the one tool that ships a source tarball rather than a per-arch
# binary, so it is pinned once and used on every architecture. It used to be
# pinned a second time in tests/bats.env for a separate fetch-bats.sh; both are
# gone, and tools.bats asserts they stay gone.
BATS_VERSION="1.14.0"
BATS_URL="https://github.com/bats-core/bats-core/archive/refs/tags/v${BATS_VERSION}.tar.gz"
BATS_SHA256="bb537b70b15b732f6d8827dd6578e3d8ce166636ce1f18ea9a074184fcce9177"
BATS_KIND="tar:bats-core-1.14.0/bin/bats"

# --- container-structure-test ----------------------------------------------
# _BIN because the executable's real name has hyphens and a shell variable
# cannot. Without it the cache held `container_structure_test`, which nothing
# looks for - bin/structure-test.sh silently fell back to whatever unpinned
# copy happened to be on PATH, and CI's fetch of the hyphenated name failed
# outright.
CONTAINER_STRUCTURE_TEST_BIN="container-structure-test"
CONTAINER_STRUCTURE_TEST_VERSION="1.22.1"
CONTAINER_STRUCTURE_TEST_URL="https://github.com/GoogleContainerTools/container-structure-test/releases/download/v${CONTAINER_STRUCTURE_TEST_VERSION}/container-structure-test-linux-amd64"
CONTAINER_STRUCTURE_TEST_SHA256="fa35e89512a8978585f76cf41397956d2e3a30c62c2ad3fb857b1597074d14ca"
CONTAINER_STRUCTURE_TEST_KIND="binary"

# The ordered list of tools, so scripts can iterate without hardcoding names.
LARAOCI_TOOLS="SHFMT YQ HADOLINT ACTIONLINT BATS CONTAINER_STRUCTURE_TEST"
