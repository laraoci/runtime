# shellcheck shell=bash disable=SC2034  # sourced data file; vars used by callers
# Single source of truth for every pinned CI/dev tool in LaraOCI.
#
# Each tool is pinned by SHA-256, not just version: a release asset can be
# replaced in place, so the hash is the trust anchor (see bin/fetch-tools.sh).
# Both CI (.github/workflows) and local `make tools` read THIS file, so a
# version exists in exactly one place and local/CI cannot drift.
#
# Format per tool: NAME_VERSION / NAME_URL / NAME_SHA256 / NAME_KIND
#   KIND=binary   -> the asset IS the executable (installed directly)
#   KIND=tar:PATH -> asset is a .tar.gz; PATH is the executable inside it
#
# A tool that ships ONE asset for every architecture declares NAME_URL and
# NAME_SHA256. A tool that ships one asset PER architecture declares
# NAME_URL_AMD64 / NAME_SHA256_AMD64 / NAME_URL_ARM64 / NAME_SHA256_ARM64;
# bin/fetch-tools.sh picks the pair matching `uname -m` and falls back to the
# unsuffixed pair. NAME_VERSION, NAME_KIND and NAME_BIN are never per-arch.
#
# The arch names are AMD64 / ARM64 - the spelling config/images.yml uses for
# build platforms - not uname's x86_64 / aarch64, so one vocabulary covers the
# images and the toolchain that tests them.
#
# To bump a tool: change its version and both URLs, download both assets, put
# their sha256 here, and run `make tools`. tests/unit/tools.bats asserts every
# SHA is 64 hex chars and every URL contains its declared version, on both
# architectures.
#
# jq IS DELIBERATELY NOT PINNED, recorded here, so it is a decision rather than an
# omission (code review 2026-07-31, finding 6). Unlike yq it reads no
# configuration: its input is JSON that yq has already produced and its output is
# consumed by GitHub's matrix parser, which rejects malformed JSON loudly rather
# than acting on a wrong value. The four filters used (object construction, array
# concatenation, `length`, `--argjson`) are unchanged across 1.6, 1.7 and 1.8.
# Compare yq, whose output BECOMES the tag, the uid and the budget - which is why
# it is pinned and resolved through this fetcher.

# --- shfmt (shell formatter) ------------------------------------------------
SHFMT_VERSION="3.13.1"
SHFMT_URL_AMD64="https://github.com/mvdan/sh/releases/download/v3.13.1/shfmt_v3.13.1_linux_amd64"
SHFMT_SHA256_AMD64="fb096c5d1ac6beabbdbaa2874d025badb03ee07929f0c9ff67563ce8c75398b1"
SHFMT_URL_ARM64="https://github.com/mvdan/sh/releases/download/v3.13.1/shfmt_v3.13.1_linux_arm64"
SHFMT_SHA256_ARM64="32d92acaa5cd8abb29fc49dac123dc412442d5713967819d8af2c29f1b3857c7"
SHFMT_KIND="binary"

# --- yq (YAML processor, mikefarah) -----------------------------------------
YQ_VERSION="4.53.3"
YQ_URL_AMD64="https://github.com/mikefarah/yq/releases/download/v4.53.3/yq_linux_amd64"
YQ_SHA256_AMD64="fa52a4e758c63d38299163fbdd1edfb4c4963247918bf9c1c5d31d84789eded4"
YQ_URL_ARM64="https://github.com/mikefarah/yq/releases/download/v4.53.3/yq_linux_arm64"
YQ_SHA256_ARM64="578648e463a11c1b6db6010cbf41eafed6bee79466fcffa1bb446672cf7945ea"
YQ_KIND="binary"

# --- hadolint (Dockerfile linter) -------------------------------------------
# Note the asset naming: x86_64 for amd64, arm64 for arm64. Upstream is not
# consistent with the others, which is why the URL is spelled out per arch
# rather than composed from a template.
HADOLINT_VERSION="2.14.0"
HADOLINT_URL_AMD64="https://github.com/hadolint/hadolint/releases/download/v2.14.0/hadolint-linux-x86_64"
HADOLINT_SHA256_AMD64="6bf226944684f56c84dd014e8b979d27425c0148f61b3bd99bcc6f39e9dc5a47"
HADOLINT_URL_ARM64="https://github.com/hadolint/hadolint/releases/download/v2.14.0/hadolint-linux-arm64"
HADOLINT_SHA256_ARM64="331f1d3511b84a4f1e3d18d52fec284723e4019552f4f47b19322a53ce9a40ed"
HADOLINT_KIND="binary"

# --- actionlint (GitHub Actions linter) -------------------------------------
# Both arch tarballs have the same flat layout with `actionlint` at the root,
# so one KIND covers them.
ACTIONLINT_VERSION="1.7.7"
ACTIONLINT_URL_AMD64="https://github.com/rhysd/actionlint/releases/download/v1.7.7/actionlint_1.7.7_linux_amd64.tar.gz"
ACTIONLINT_SHA256_AMD64="023070a287cd8cccd71515fedc843f1985bf96c436b7effaecce67290e7e0757"
ACTIONLINT_URL_ARM64="https://github.com/rhysd/actionlint/releases/download/v1.7.7/actionlint_1.7.7_linux_arm64.tar.gz"
ACTIONLINT_SHA256_ARM64="401942f9c24ed71e4fe71b76c7d638f66d8633575c4016efd2977ce7c28317d0"
ACTIONLINT_KIND="tar:actionlint"

# --- bats (test runner) -----------------------------------------------------
# bats is the one tool that ships a source tarball rather than a per-arch
# binary, so it is pinned once and used on every architecture. It used to be
# pinned a second time in tests/bats.env for a separate fetch-bats.sh; both are
# gone, and tools.bats asserts they stay gone.
BATS_VERSION="1.14.0"
BATS_URL="https://github.com/bats-core/bats-core/archive/refs/tags/v${BATS_VERSION}.tar.gz"
BATS_SHA256="bb537b70b15b732f6d8827dd6578e3d8ce166636ce1f18ea9a074184fcce9177"
BATS_KIND="tar:bats-core-1.14.0/bin/bats"

# --- container-structure-test ----------------------------------------------
# _BIN because the executable's real name has hyphens and a shell variable
# cannot. Without it the cache held `container_structure_test`, which nothing
# looks for - bin/structure-test.sh silently fell back to whatever unpinned
# copy happened to be on PATH, and CI's fetch of the hyphenated name failed
# outright.
CONTAINER_STRUCTURE_TEST_BIN="container-structure-test"
CONTAINER_STRUCTURE_TEST_VERSION="1.22.1"
CONTAINER_STRUCTURE_TEST_URL_AMD64="https://github.com/GoogleContainerTools/container-structure-test/releases/download/v1.22.1/container-structure-test-linux-amd64"
CONTAINER_STRUCTURE_TEST_SHA256_AMD64="fa35e89512a8978585f76cf41397956d2e3a30c62c2ad3fb857b1597074d14ca"
CONTAINER_STRUCTURE_TEST_URL_ARM64="https://github.com/GoogleContainerTools/container-structure-test/releases/download/v1.22.1/container-structure-test-linux-arm64"
CONTAINER_STRUCTURE_TEST_SHA256_ARM64="801826ed107222120eb6df8c143b7de752cfebbe3aebfeea576e7098486917c2"
CONTAINER_STRUCTURE_TEST_KIND="binary"

# --- shellcheck (shell linter) ----------------------------------------------
# The .tar.gz assets, not the .tar.xz ones upstream has published for longer:
# fetch-tools.sh's tar: KIND uses `tar xzf`, and adding a xz decompressor to
# the fetcher for one tool is a worse trade than taking the gzip asset, which
# upstream publishes for every platform.
#
# The tarball has a versioned top-level directory, so KIND names the nested
# path and the whole tree is extracted to SRC_DIR.
SHELLCHECK_VERSION="0.11.0"
SHELLCHECK_URL_AMD64="https://github.com/koalaman/shellcheck/releases/download/v0.11.0/shellcheck-v0.11.0.linux.x86_64.tar.gz"
SHELLCHECK_SHA256_AMD64="b7af85e41cc99489dcc21d66c6d5f3685138f06d34651e6d34b42ec6d54fe6f6"
SHELLCHECK_URL_ARM64="https://github.com/koalaman/shellcheck/releases/download/v0.11.0/shellcheck-v0.11.0.linux.aarch64.tar.gz"
SHELLCHECK_SHA256_ARM64="68a8133197a50beb8803f8d42f9908d1af1c5540d4bb05fdfca8c1fa47decefc"
SHELLCHECK_KIND="tar:shellcheck-v0.11.0/shellcheck"

# --- trivy (vulnerability scanner) ------------------------------------------
# DELIBERATELY NOT aquasecurity/trivy-action, and this is not a style choice.
# On 2026-03-19 a threat actor with compromised credentials force-pushed 76 of
# the action's 77 tags - and all 7 tags of setup-trivy - to credential-stealing
# malware, alongside a malicious trivy v0.69.4 release. A SHA-pinned action
# survives a tag force-push; a CHECKSUM-pinned binary survives that AND a
# release asset replaced in place, which is the threat this file's header
# already names. Using the marketplace action in the milestone whose subject is
# supply-chain integrity would encode the wrong lesson.
#
# tests/unit/workflows.bats (L5) forbids curl in a run: body for the same
# reason, so this is also the only route CI has.
#
# The asset naming is upstream's own: Linux-64bit for amd64, Linux-ARM64 for
# arm64 - spelled out per arch rather than composed, like hadolint's.
TRIVY_VERSION="0.72.0"
TRIVY_URL_AMD64="https://github.com/aquasecurity/trivy/releases/download/v0.72.0/trivy_0.72.0_Linux-64bit.tar.gz"
TRIVY_SHA256_AMD64="bbb64b9695866ce4a7a8f5c9592002c5961cab378577fa3f8a040df362b9b2ea"
TRIVY_URL_ARM64="https://github.com/aquasecurity/trivy/releases/download/v0.72.0/trivy_0.72.0_Linux-ARM64.tar.gz"
TRIVY_SHA256_ARM64="2ca2c023109c2db6b2b77366b6717291452d4531167377d95c79547f0c8e3467"
TRIVY_KIND="tar:trivy"

# --- cosign (keyless signing, §11) ------------------------------------------
# v3: --new-bundle-format is on by default. Fetched through the checksum-pinned
# fetcher for the same reason trivy is - see the TRIVY block - and because
# workflows.bats (L5) forbids a bare curl in a run: body.
COSIGN_VERSION="3.1.3"
COSIGN_URL_AMD64="https://github.com/sigstore/cosign/releases/download/v3.1.3/cosign-linux-amd64"
COSIGN_SHA256_AMD64="4629c757b7618056f8ddd7e2625ae9fdd94c0372a65049520bc7d9df9efc7f71"
COSIGN_URL_ARM64="https://github.com/sigstore/cosign/releases/download/v3.1.3/cosign-linux-arm64"
COSIGN_SHA256_ARM64="c5d324e091826b0d7a78eb16fef316450b4eb9aaec045611c08ba06f5e73220a"
COSIGN_KIND="binary"

# The ordered list of tools, so scripts can iterate without hardcoding names.
LARAOCI_TOOLS="SHFMT YQ HADOLINT ACTIONLINT BATS CONTAINER_STRUCTURE_TEST SHELLCHECK TRIVY COSIGN"
