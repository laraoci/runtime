; LaraOCI baseline - spec §6.5. Rendered from this template by
; /usr/local/bin/laraoci-entrypoint at container start, into
; ${PHP_INI_DIR}/conf.d/zz-laraoci.ini.
;
; Sorts last in conf.d, so mounting a lexically later file (zzz-yours.ini)
; overrides anything here. Do not add opcache.preload: per 🧭 4 the entrypoint
; writes it to zz-laraoci-preload.ini, and only for FPM.
;
; No disable_functions (§6.5): Laravel uses proc_open and exec legitimately.

expose_php = Off
display_errors = Off
display_startup_errors = Off
log_errors = On
error_log = /proc/self/fd/2
date.timezone = UTC
realpath_cache_size = 4096K
realpath_cache_ttl = 600

memory_limit = ${PHP_MEMORY_LIMIT}
max_execution_time = ${PHP_MAX_EXECUTION_TIME}
upload_max_filesize = ${PHP_UPLOAD_MAX_FILESIZE}
post_max_size = ${PHP_POST_MAX_SIZE}

opcache.enable = ${PHP_OPCACHE_ENABLE}
; Deliberate (§6.5): queue and scheduler are long-lived CLI processes.
opcache.enable_cli = 1
; 0 means the container must be replaced to pick up code changes - correct for
; immutable deploys, loud in the docs for anyone bind-mounting source.
opcache.validate_timestamps = ${PHP_OPCACHE_VALIDATE_TIMESTAMPS}
opcache.revalidate_freq = 0
opcache.memory_consumption = ${PHP_OPCACHE_MEMORY_CONSUMPTION}
opcache.interned_strings_buffer = 16
opcache.max_accelerated_files = ${PHP_OPCACHE_MAX_ACCELERATED_FILES}
; D11: neutral-to-negative for typical FPM/Laravel workloads.
opcache.jit = disable
